pipeline {
    agent { label 'windows' }

    environment {
        // Carpeta donde está tu package.json
        FRONT_DIR = 'GYM.FrontEnd' 
        
        SAS_TOKEN = credentials('web-sas')

        // REEMPLAZA ESTO: Pon el nombre exacto de la cuenta de storage que acabas de crear
        STORAGE_URL = 'https://gymweb2026.blob.core.windows.net/$web'
        VITE_BASE_API_URL = 'https://gym-api-e8gkdgcxc6fqhufn.centralus-01.azurewebsites.net/api'

        // REEMPLAZA ESTO: Pon la URL real de tu backend que probamos hace un momento
        VITE_API_URL = 'https://gym-api-e8gkdgcxc6fqhufn.centralus-01.azurewebsites.net/api' //Agrega /api si tus controladores lo usan o si en tu front no está ya concatenado, quítalo.

    }

    stages {
        
        stage('Install Dependencies') {
            steps {
                dir(env.FRONT_DIR) {
                    bat 'npm install'
                }
            }
        }

        stage('Build') {
            steps {
                dir(env.FRONT_DIR) {
                    bat 'npm run build'
                }
            }
        }

        // Solo configurado para tests de Cypress, adaptar o agregar otro step/stage si usan selenium en sus tests.
        // stage('E2E Tests') {
        //     steps {
        //         dir(env.FRONT_DIR) {
        //             bat 'npm run test:e2e:ci' //Esto es para correr cypress headless, comando configurado en el 'package.json':
        //             // "test:e2e:ci": "start-server-and-test \"npm run preview -- --host 127.0.0.1 --port 5173\" http://127.0.0.1:5173 e2e"
        //         }
        //     }
        // }
        // STAGE: Headless Cypress Integration Tests
        stage('Cypress Integration Tests') {
            steps {
                dir(env.FRONT_DIR) {
                    // FIXED: Invokes your native package.json command script 'npm run cy:run' inside the orchestrator
                    bat 'npx start-server-and-test dev http://localhost:5173 "npm run cy:run"'
                }
            }
        }

        // // STAGE: End-to-End Selenium Tests
        // stage('Selenium E2E Tests') {
        //     steps {
        //         // FIXED: Directs the workspace context to step inside your exact nested project folder path
        //         dir("${env.FRONT_DIR}/e2e-selenium/GYM.Tests.E2E.Selenium") {
        //             // Clears out previous test results to prevent telemetry contamination
        //             powershell 'Remove-Item -Recurse -Force */TestResults -ErrorAction SilentlyContinue'
                    
        //             // Executes your Selenium test files headlessly using the Release configuration profile
        //             bat 'dotnet test -c Release --logger "junit;LogFilePath=TestResults/{assembly}.junit.xml" --logger trx'
        //         }
        //     }
        // }

        stage('Deploy to Azure Blob') {
            steps {
                dir(env.FRONT_DIR) {
                    //bat 'azcopy copy "dist\\*" "%STORAGE_URL%?%SAS_TOKEN%" --recursive=true'
                    powershell 'azcopy copy "dist\\*" "$env:STORAGE_URL`?$env:SAS_TOKEN" --recursive=true --from-to=LocalBlob'
                }
            }
        }
    }
}